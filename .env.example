# Public values are embedded in the browser bundle. Keep credentials out of NEXT_PUBLIC_*.
NEXT_PUBLIC_EMAIL=your.email@example.com
NEXT_PUBLIC_PHONE_RAW=+911234567890
NEXT_PUBLIC_PHONE_FORMATTED="+91 12345 67890"
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/yourprofile/
NEXT_PUBLIC_GITHUB_URL=https://github.com/yourusername
NEXT_PUBLIC_USER_NAME="Elamaran A"
NEXT_PUBLIC_USER_FIRST_NAME=Elamaran
NEXT_PUBLIC_USER_LAST_NAME=A
NEXT_PUBLIC_USER_ROLE_PRIMARY="Full Stack Developer — MERN"
NEXT_PUBLIC_USER_ROLES="MERN Stack Developer,React Developer,Full Stack Engineer"
NEXT_PUBLIC_YEARS_EXPERIENCE=1+
NEXT_PUBLIC_PROJECTS_COUNT=5+
NEXT_PUBLIC_CLIENTS_COUNT=2+

# These two public values must match API_KEY / APP_HEADER_* below.
NEXT_PUBLIC_API_KEY=replace-with-api-key
NEXT_PUBLIC_APP_HEADER_NAME=x-client-access-id-pf
NEXT_PUBLIC_APP_HEADER_VALUE=replace-with-app-header-value

# Server-only values for Next.js Route Handlers.
MONGODB_URI=mongodb+srv://username:password@cluster.example/portfolio
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-long-random-secret
API_KEY=replace-with-api-key
APP_HEADER_NAME=x-client-access-id-pf
APP_HEADER_VALUE=replace-with-app-header-value
MAIL_SERVICE=gmail
MAIL_SENDER_EMAIL=your.email@gmail.com
MAIL_SENDER_PASS=replace-with-mail-app-password
MAIL_RECIPIENT_EMAIL=your.email@example.com
